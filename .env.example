# ==========================================================================
# Backend env vars. Copy to .env for local dev, or set on Fly.io for prod.
# ==========================================================================

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Production-only: origins trusted for CSRF (include the Vercel URL)
CSRF_TRUSTED_ORIGINS=https://glenwood-hoa.vercel.app,https://your-custom-domain.com

# --- Database (Neon in prod) ---
# Neon gives you a connection string like:
#   postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# --- Redis (optional; needed for Celery background tasks) ---
REDIS_URL=redis://localhost:6379/0

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@glenwoodpark.example

# --- Cloudflare R2 (production media storage) ---
# Create a bucket + API token in the Cloudflare dashboard.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# e.g. https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Optional: public custom domain for the bucket, e.g. files.yourhoa.com
R2_CUSTOM_DOMAIN=
